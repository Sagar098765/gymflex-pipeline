<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gymflex</groupId>
    <artifactId>gymflex</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>
    <name>GymFlex Website</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- This module packages the static website, not the unfinished Java backend. -->
        <!-- Keep the existing Java files in src/main/java, but do not compile them here. -->
        <maven.main.skip>true</maven.main.skip>

        <!-- Do not compile or execute the existing Java tests in this static-site build. -->
        <!-- Jenkins performs a separate validation of the generated WAR contents. -->
        <maven.test.skip>true</maven.test.skip>
    </properties>

    <build>
        <finalName>gymflex</finalName>

        <plugins>
            <!-- Build the static HTML/CSS/JS website as a WAR file. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <!-- Frontend is a sibling of gymflexapp, one level above this POM. -->
                    <warSourceDirectory>${project.basedir}/../Gymflex website/Frontend</warSourceDirectory>
                    <failOnMissingWebXml>false</failOnMissingWebXml>

                    <!-- Copy the sibling Images folder into the WAR as Images/. -->
                    <webResources>
                        <resource>
                            <directory>${project.basedir}/../Gymflex website/Images</directory>
                            <targetPath>Images</targetPath>
                            <filtering>false</filtering>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>

            <!-- Explicitly skip Java compilation for this static website module. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
        </plugins>
    </build>

</project>
