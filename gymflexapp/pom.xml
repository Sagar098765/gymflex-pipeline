
<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Maven project model version -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Project identification -->
    <groupId>com.gymflex</groupId>
    <artifactId>gymflex</artifactId>
    <version>1.0.0</version>

    <!-- Create a WAR file instead of a JAR -->
    <packaging>war</packaging>

    <name>GymFlex Website</name>

    <properties>
        <!-- Use UTF-8 encoding -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>

        <!-- Final output will be gymflex.war -->
        <finalName>gymflex</finalName>

        <plugins>

            <!-- Maven plugin responsible for building WAR files -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>

                <configuration>

                    <!-- Take HTML, CSS and JS files from Frontend -->
                    <warSourceDirectory>
                        ${project.basedir}/Frontend
                    </warSourceDirectory>

                    <!-- No web.xml required for this static website -->
                    <failOnMissingWebXml>false</failOnMissingWebXml>

                    <!-- Add images to the WAR file -->
                    <webResources>
                        <resource>
                            <directory>
                                ${project.basedir}/Images
                            </directory>

                            <!-- Keep the Images folder inside the WAR -->
                            <targetPath>Images</targetPath>

                            <!-- Copy files without changing their contents -->
                            <filtering>false</filtering>
                        </resource>
                    </webResources>

                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
