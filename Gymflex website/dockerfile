
FROM alpine:3.22 AS extract

RUN apk add --no-cache unzip

WORKDIR /app

COPY target/gymflex.war /app/gymflex.war

RUN mkdir -p /website \
    && unzip -q /app/gymflex.war -d /website \
    && test -f /website/index.html


FROM nginx:alpine

RUN rm -rf /usr/share/nginx/html/*

COPY --from=extract /website/ /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
